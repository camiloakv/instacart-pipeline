[0m13:37:11.030880 [debug] [Thread-4 (]: On model.instacart_pipeline.int_product_stats: /* {"app": "dbt", "dbt_version": "1.8.2", "profile_name": "instacart_pipeline", "target_name": "dev", "node_id": "model.instacart_pipeline.int_product_stats"} */

  create view "instacart"."dbt_dev"."int_product_stats__dbt_tmp"
    
    
  as (
    -- One row per product, summarizing how often it gets reordered across
-- all users. A high-level "popularity/stickiness" signal for the model.

select
    product_id,
    count(*) as product_total_orders,
    avg(reordered) as product_reorder_rate
from "instacart"."dbt_dev"."int_order_products_unioned"
where eval_set = 'prior'
group by product_id
  );
